<?xml version="1.0" encoding="utf-8"?>
<extension type="component" method="upgrade">
	<name>COM_SIMPLESTATS</name>
	<version>0.3.3</version>
	<targetplatform name="joomla" version="6.*" />
	<creationDate>2026-07-23</creationDate>
	<author>Frank Willeke</author>
	<copyright>Copyright (C) 2026 Frank Willeke</copyright>
	<license>GNU General Public License version 2 or later</license>
	<description>COM_SIMPLESTATS_XML_DESCRIPTION</description>
	<namespace path="src">FrankWilleke\Component\Simplestats</namespace>
	<scriptfile>script.php</scriptfile>
	<administration>
		<menu img="class:chart">COM_SIMPLESTATS</menu>
		<files folder="admin">
			<folder>services</folder>
			<folder>src</folder>
			<folder>tmpl</folder>
			<folder>sql</folder>
			<filename>access.xml</filename>
			<filename>config.xml</filename>
			<filename>LICENSE.txt</filename>
		</files>
		<languages folder="admin/language">
			<language tag="en-GB">en-GB/com_simplestats.ini</language>
			<language tag="en-GB">en-GB/com_simplestats.sys.ini</language>
			<language tag="de-DE">de-DE/com_simplestats.ini</language>
			<language tag="de-DE">de-DE/com_simplestats.sys.ini</language>
		</languages>
	</administration>
	<media destination="com_simplestats" folder="media">
		<folder>css</folder>
		<filename>joomla.asset.json</filename>
	</media>
	<install>
		<sql>
			<file driver="mysql" charset="utf8mb4">admin/sql/install.mysql.utf8.sql</file>
		</sql>
	</install>
	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8mb4">admin/sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>
	<update>
		<schemas>
			<schemapath type="mysql">sql/updates/mysql</schemapath>
		</schemas>
	</update>
</extension>
